rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Admin check - bootstrap with user email
    function isAdmin() { 
      return isVerified() && (
        request.auth.token.email == 'nelson.bravo.salas@gmail.com' ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.perfil in ['administrador', 'programador']
      );
    }

    // Validation Blueprints
    function isValidEquipo(data) {
      return data.keys().hasAll(['tag', 'nombre', 'ownerId']) &&
             data.keys().size() >= 3 && data.keys().size() <= 20 &&
             data.tag is string && data.tag.size() <= 64 &&
             data.nombre is string && data.nombre.size() <= 128 &&
             data.ownerId == request.auth.uid &&
             (!('estado' in data) || data.estado in ["Operativo", "Falla", "Mantenimiento", "Baja"]) &&
             (!('horasOperacion' in data) || data.horasOperacion is number);
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['tag', 'titulo', 'creador', 'ownerId']) &&
             data.keys().size() >= 4 && data.keys().size() <= 15 &&
             data.tag is string && data.tag.size() <= 64 &&
             data.titulo is string && data.titulo.size() <= 128 &&
             data.creador is string &&
             data.ownerId == request.auth.uid;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['nombre', 'correo', 'perfil']) &&
             data.keys().size() >= 3 && data.keys().size() <= 10 &&
             data.nombre is string && data.correo is string &&
             data.perfil in ["visita", "tecnico", "supervisor", "administrador", "programador", "cliente", "contratista"];
    }

    // Collection: Equipos
    match /equipos/{equipoId} {
      allow get: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if isVerified() && isValidId(equipoId) && isValidEquipo(incoming());
      
      allow update: if isVerified() && isValidId(equipoId) && 
                      (isAdmin() || (
                        resource.data.ownerId == request.auth.uid && 
                        isValidEquipo(incoming()) &&
                        incoming().ownerId == existing().ownerId &&
                        incoming().tag == existing().tag &&
                        (!existing().keys().hasAll(['estado']) || existing().estado != 'Baja')
                      ));
                      
      allow delete: if isAdmin();
    }

    // Collection: Tickets
    match /tickets/{ticketId} {
      allow get: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if isVerified() && isValidId(ticketId) && isValidTicket(incoming());
      
      allow update: if isVerified() && isValidId(ticketId) && 
                      (isAdmin() || (
                        resource.data.ownerId == request.auth.uid && 
                        isValidTicket(incoming()) &&
                        incoming().ownerId == existing().ownerId
                      ));
                      
      allow delete: if isAdmin();
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isVerified() && (userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isVerified() && userId == request.auth.uid && isValidUser(incoming());
      
      allow update: if isVerified() && (isAdmin() || (
                        userId == request.auth.uid && 
                        isValidUser(incoming()) &&
                        (!incoming().keys().hasAll(['perfil']) || incoming().perfil == existing().perfil)
                      ));
      
      allow delete: if isAdmin();
    }
  }
}
