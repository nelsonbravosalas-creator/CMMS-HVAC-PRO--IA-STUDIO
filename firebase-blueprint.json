{
  "entities": {
    "Equipo": {
      "title": "Equipo",
      "description": "Un activo técnico del sistema CMMS",
      "type": "object",
      "properties": {
        "tag": { "type": "string" },
        "nombre": { "type": "string" },
        "tipo": { "type": "string" },
        "marca": { "type": "string" },
        "modelo": { "type": "string" },
        "serie": { "type": "string" },
        "ubicacion": { "type": "string" },
        "area": { "type": "string" },
        "capacidad": { "type": "string" },
        "voltaje": { "type": "string" },
        "corriente": { "type": "string" },
        "refrigerante": { "type": "string" },
        "fechaInstalacion": { "type": "string", "format": "date" },
        "vidaUtil": { "type": "number" },
        "estado": { "type": "string", "enum": ["Operativo", "Falla", "Mantenimiento", "Baja"] },
        "ultimoMantenimiento": { "type": "string", "format": "date" },
        "proximoMantenimiento": { "type": "string", "format": "date" },
        "horasOperacion": { "type": "number" },
        "tecnicos": { "type": "array", "items": { "type": "string" } },
        "notas": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["tag", "nombre", "ownerId"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "Una solicitud de mantenimiento o falla",
      "type": "object",
      "properties": {
        "tag": { "type": "string" },
        "titulo": { "type": "string" },
        "descripcion": { "type": "string" },
        "tipo": { "type": "string", "enum": ["Falla", "Inspeccion", "Consulta"] },
        "prioridad": { "type": "string", "enum": ["baja", "media", "alta", "critica"] },
        "estado": { "type": "string", "enum": ["Abierto", "En_proceso", "Resuelto", "Re-Asignado"] },
        "creador": { "type": "string" },
        "asignado": { "type": "string" },
        "fecha": { "type": "string", "format": "date" },
        "notas": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["tag", "titulo", "creador", "ownerId"]
    },
    "User": {
      "title": "User",
      "description": "Información del usuario",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "correo": { "type": "string" },
        "perfil": { "type": "string", "enum": ["visita", "tecnico", "supervisor", "administrador", "programador", "cliente", "contratista"] },
        "activo": { "type": "boolean" },
        "puedeEditarMantenimientos": { "type": "boolean" },
        "pin": { "type": "string" }
      },
      "required": ["nombre", "correo", "perfil"]
    }
  },
  "firestore": {
    "/equipos/{equipoId}": {
      "schema": "Equipo",
      "description": "Colección de equipos registrados"
    },
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Colección de tickets de soporte"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Perfiles de usuario personalizados"
    }
  }
}
