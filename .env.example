# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=http://localhost:3000

# DATABASE_URL: PostgreSQL Connection String for Neon DB
DATABASE_URL=

# Secretos del servidor. Genere valores aleatorios distintos de al menos 32 bytes.
JWT_SECRET=
SECURITY_HASH_PEPPER=
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_WEBHOOK_TOKEN=

# Resend (servidor únicamente).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Usuarios demo exclusivamente locales. Nunca habilitar en Vercel.
CMMS_ENABLE_DEMO_USERS=false
CMMS_DEMO_EMAIL=
CMMS_DEMO_PIN=

# Provisionamiento inicial productivo. Retirar después del primer cambio de PIN.
CMMS_BOOTSTRAP_ADMIN_EMAIL=
CMMS_BOOTSTRAP_ADMIN_PIN=
