# Copy this file to .env.local and set real values before running Docker Compose.

# Public port exposed on the host.
APP_PORT=3001

# Public URL used by QR links and callbacks.
APP_URL=http://localhost:3001

# Local Docker PostgreSQL profile.
POSTGRES_DB=cmms_hvac
POSTGRES_USER=cmms
POSTGRES_PASSWORD=cmms_password
POSTGRES_PORT=5432

# Internal PostgreSQL connection string used by the local profile.
DATABASE_URL=postgresql://cmms:cmms_password@postgres:5432/cmms_hvac

# Neon profile connection string. Neon requires sslmode=require.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Required for production JWT signing.
JWT_SECRET=replace_with_a_long_random_secret

# Required for OCR / Gemini features.
GEMINI_API_KEY=replace_with_your_gemini_key
