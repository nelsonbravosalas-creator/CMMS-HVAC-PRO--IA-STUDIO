{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    { "source": "/api/assets/:id/execute", "destination": "/api/core.ts?handler=assets&id=:id&action=execute" },
    { "source": "/api/assets/:id", "destination": "/api/core.ts?handler=assets&id=:id" },
    { "source": "/api/assets", "destination": "/api/core.ts?handler=assets" },

    { "source": "/api/maintenance/:id/execute", "destination": "/api/operations.ts?handler=maintenance&id=:id&action=execute" },
    { "source": "/api/maintenance/:id", "destination": "/api/operations.ts?handler=maintenance&id=:id" },
    { "source": "/api/maintenance", "destination": "/api/operations.ts?handler=maintenance" },

    { "source": "/api/work-orders/:id/complete", "destination": "/api/operations.ts?handler=work-orders&id=:id&action=complete" },
    { "source": "/api/work-orders/:id", "destination": "/api/operations.ts?handler=work-orders&id=:id" },
    { "source": "/api/work-orders", "destination": "/api/operations.ts?handler=work-orders" },

    { "source": "/api/parts/:id/adjust", "destination": "/api/operations.ts?handler=inventory&id=:id&action=adjust" },
    { "source": "/api/parts/:id", "destination": "/api/operations.ts?handler=inventory&id=:id" },
    { "source": "/api/parts", "destination": "/api/operations.ts?handler=inventory" },
    { "source": "/api/inventory", "destination": "/api/operations.ts?handler=inventory" },

    { "source": "/api/branches", "destination": "/api/core.ts?handler=clients&resource=branches" },
    { "source": "/api/clients", "destination": "/api/core.ts?handler=clients" },

    { "source": "/api/sync/push", "destination": "/api/sync.ts?handler=sync" },
    { "source": "/api/sync/pull", "destination": "/api/sync.ts?handler=sync" },
    { "source": "/api/sync/status", "destination": "/api/sync.ts?handler=sync&status=1" },
    { "source": "/api/sync/:table", "destination": "/api/sync.ts?handler=sync&table=:table" },
    { "source": "/api/sync", "destination": "/api/sync.ts?handler=sync" },

    { "source": "/api/users", "destination": "/api/core.ts?handler=users" },
    { "source": "/api/auth", "destination": "/api/auth.ts" },
    { "source": "/api/auth/biometric-verify", "destination": "/api/auth.ts?action=biometric-verify" },
    { "source": "/api/change-pin", "destination": "/api/auth.ts?action=change-pin" },
    { "source": "/api/logout", "destination": "/api/auth.ts?action=logout" },
    { "source": "/api/health", "destination": "/api/auth.ts?action=health" },
    { "source": "/api/import-data", "destination": "/api/admin.ts?handler=import-data" },
    { "source": "/api/init-db", "destination": "/api/admin.ts?handler=init-db" },

    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
